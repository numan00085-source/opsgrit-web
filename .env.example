# Public canonical URL of the site (used for sitemap, canonical tags, Open Graph)
NEXT_PUBLIC_SITE_URL=https://opsgrit.com

# Contact address shown on /contact and in policy pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@opsgrit.com

# Optional: newsletter provider endpoint (form POSTs the email here). Leave blank to disable submission.
NEXT_PUBLIC_NEWSLETTER_ACTION=
