# Public canonical URL of the site (used for sitemap, canonical tags, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.getopsgrit.com

# Contact address shown on /contact and in policy pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@getopsgrit.com

# Newsletter sign-ups are stored in the same Upstash Redis database as the view counter (see below).

# Optional: page-view counter storage (Upstash Redis REST). Added automatically when you connect Upstash Redis in Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: Google AdSense (set after approval). Ads render only when the client id is set.
# Client looks like ca-pub-1234567890123456; slot ids come from AdSense > Ads > By ad unit.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Optional: time zone used for daily counts (default America/Detroit) and a private salt for visitor hashing
ANALYTICS_TZ=
ANALYTICS_SALT=
